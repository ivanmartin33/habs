{
  "expo": {
    "name": "Habits",
    "slug": "habs",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "habits",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habits.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.habits.app",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4f8cff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4cb9aacd-3254-4f9d-bc87-33199fb7e536"
      }
    }
  }
}
